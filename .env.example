# Sao chép file này thành .env.local trong từng app (apps/web, apps/admin, apps/mobile) và điền giá trị thật.
# Để trống = FE chạy bằng dữ liệu giả, không cần Supabase.
#
# Lấy ở Supabase Dashboard → Project Settings → API:
#   Project URL      → SUPABASE_URL
#   anon public key  → SUPABASE_ANON_KEY   (khóa công khai, an toàn để đưa vào FE)
# TUYỆT ĐỐI KHÔNG dùng "service_role" key trong FE.

# apps/web và apps/admin (Vite)
VITE_SUPABASE_URL=https://duysdrfgreifshotwhqi.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_e42K0AltJQF_iYKUZFsheg_1pYyT3Da


# apps/mobile (Expo)
EXPO_PUBLIC_SUPABASE_URL=https://duysdrfgreifshotwhqi.supabase.co
